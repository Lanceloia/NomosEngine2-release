  "samples": [
    {
      "scene": "purpose",
      "line": 0,
      "image": "scene-01-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "如果玩家做了作者没有预料到的事，游戏世界还能给出可信的后果吗？",
      "active": true
    },
    {
      "scene": "purpose",
      "line": 1,
      "image": "scene-01-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "Nomos 希望用世界规则构建角色扮演沙盒，而不是为每种选择手写剧情分支。",
      "active": true
    },
    {
      "scene": "story",
      "line": 0,
      "image": "scene-02-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "作者定义人物、物件和规律。玩家选择行动，角色也可以按有限策略选择。",
      "active": true
    },
    {
      "scene": "story",
      "line": 1,
      "image": "scene-02-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "剧情不是源码中的行动清单，而是实际选择与规则结算留下的历史。",
      "active": true
    },
    {
      "scene": "assets",
      "line": 0,
      "image": "scene-03-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "规则库定义类型和规律。端口不是网络端口，它声明规则能读取谁的状态、修改哪些字段。",
      "active": true
    },
    {
      "scene": "assets",
      "line": 1,
      "image": "scene-03-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "世界声明选择规则、绑定参与者；开局资产提供角色、资源和位置。",
      "active": true
    },
    {
      "scene": "compiler",
      "line": 0,
      "image": "scene-04-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "C 零编译作者声明，构建规则程序；程序绑定开局，创建会话。",
      "active": true
    },
    {
      "scene": "compiler",
      "line": 1,
      "image": "scene-04-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "K 零重核提交的行动。状态变化与记录一起提交，保留行动者和规则来源。菜单候选不等于行动必定获准。",
      "active": true
    },
    {
      "scene": "verify",
      "line": 0,
      "image": "scene-05-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "T 零检查源码之外的测试路线：希望尝试哪些行动、检查什么目标。它使用同一编译产物，真实运行。",
      "active": true
    },
    {
      "scene": "verify",
      "line": 1,
      "image": "scene-05-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "一条路线失败，不等于所有玩法都不可达。",
      "active": true
    },
    {
      "scene": "admission",
      "line": 0,
      "image": "scene-06-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "只给女巫规则增加不能自救。开局和请求不变，前九步行动、事件及规则来源相同。",
      "active": true
    },
    {
      "scene": "admission",
      "line": 1,
      "image": "scene-06-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "第十步从成功变为拒绝，本步无写入。救人候选仍然存在，这不是菜单自动过滤。",
      "active": true
    },
    {
      "scene": "consequence",
      "line": 0,
      "image": "scene-07-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "三名狼人分别选择 F、F、E。只把共同袭击规则从全票一致换成多数票。",
      "active": true
    },
    {
      "scene": "consequence",
      "line": 1,
      "image": "scene-07-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "十次行动全部获准，但全票版无人死亡，多数票版 F 清晨死亡。规则也决定真实后果。",
      "active": true
    },
    {
      "scene": "configuration",
      "line": 0,
      "image": "scene-08-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "保持规则不变，把女巫从 B 换到 E，通知、选项和行动来源一起转到 E。",
      "active": true
    },
    {
      "scene": "configuration",
      "line": 1,
      "image": "scene-08-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "增加 G、H 后，有独立视图，G 能真实投票。仍须同步人物声明与开局，不是只改人数开关。",
      "active": true
    },
    {
      "scene": "adventure",
      "line": 0,
      "image": "scene-09-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "冰宫冒险 M 一，把充能、寒冷、观察、角色有限选择和营救组合起来。",
      "active": true
    },
    {
      "scene": "adventure",
      "line": 1,
      "image": "scene-09-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "世界真相与角色知识分开。解冻不等于营救，邀请不等于接受。样例不代表完整桌游。",
      "active": true
    },
    {
      "scene": "future",
      "line": 0,
      "image": "scene-10-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "未来，语言模型可以草拟内容，读取授权信息，提出行动，讲述已发生的故事。",
      "active": true
    },
    {
      "scene": "future",
      "line": 1,
      "image": "scene-10-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "但不能绕过规则写入结局。想象力与确定性结算，在这里连接。",
      "active": true
    },
    {
      "scene": "status",
      "line": 0,
      "image": "scene-11-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "当前已有有限编译链、结算内核、见证检查与真实编辑实验。尚不是通用 TRPG、多人服务或语言模型主持人。",
      "active": true
    },
    {
      "scene": "status",
      "line": 1,
      "image": "scene-11-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "发起者负责问题、方向、语义决策与验收。后期主要代码由 Codex 和协作者实现或审阅。",
      "active": true
    },
    {
      "scene": "close",
      "line": 0,
      "image": "scene-12-1.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "从中文导览开始，再看真实命令回放，或亲手改一条规则。",
      "active": true
    },
    {
      "scene": "close",
      "line": 1,
      "image": "scene-12-2.png",
      "overflow": false,
      "diagramOverlap": false,
      "subtitle": "作者定义世界允许发生什么，玩家决定故事如何发生。",
      "active": true
    }
  ],

{
  "title": "NomosEngine2：让规则产生故事",
  "voice": "Microsoft Huihui Desktop",
  "rate": 3,
  "scenes": [
    {
      "id": "purpose",
      "title": "让规则产生故事",
      "tag": "项目动机",
      "visual": "world",
      "lines": [
        {
          "text": "如果玩家做了作者没有预料到的事，游戏世界还能给出可信的后果吗？",
          "focus": "choice",
          "start": 0.6,
          "end": 5.854875283446712
        },
        {
          "text": "Nomos 希望用世界规则构建角色扮演沙盒，而不是为每种选择手写剧情分支。",
          "focus": "world",
          "start": 6.354875283446712,
          "end": 12.296462585034014
        }
      ],
      "start": 0.6,
      "end": 12.296462585034014
    },
    {
      "id": "story",
      "title": "定义世界，不预写结局",
      "tag": "理念示意 · 不是实际运行录像",
      "visual": "story",
      "lines": [
        {
          "text": "作者定义人物、物件和规律。玩家选择行动，角色也可以按有限策略选择。",
          "focus": "rules",
          "start": 12.796462585034014,
          "end": 19.377551020408163
        },
        {
          "text": "剧情不是源码中的行动清单，而是实际选择与规则结算留下的历史。",
          "focus": "history",
          "start": 19.877551020408163,
          "end": 25.36875283446712
        }
      ],
      "start": 12.796462585034014,
      "end": 25.36875283446712
    },
    {
      "id": "assets",
      "title": "作者写什么？",
      "tag": "当前作者接口",
      "visual": "assets",
      "lines": [
        {
          "text": "规则库定义类型和规律。端口不是网络端口，它声明规则能读取谁的状态、修改哪些字段。",
          "focus": "library",
          "start": 25.86875283446712,
          "end": 33.531791383219954
        },
        {
          "text": "世界声明选择规则、绑定参与者；开局资产提供角色、资源和位置。",
          "focus": "opening",
          "start": 34.031791383219954,
          "end": 39.867392290249434
        }
      ],
      "start": 25.86875283446712,
      "end": 39.867392290249434
    },
    {
      "id": "compiler",
      "title": "声明，变成可运行的世界",
      "tag": "当前实现 · 架构示意",
      "visual": "pipeline",
      "lines": [
        {
          "text": "C 零编译作者声明，构建规则程序；程序绑定开局，创建会话。",
          "focus": "compile",
          "start": 40.367392290249434,
          "end": 46.01133786848072
        },
        {
          "text": "K 零重核提交的行动。状态变化与记录一起提交，保留行动者和规则来源。菜单候选不等于行动必定获准。",
          "focus": "runtime",
          "start": 46.51133786848072,
          "end": 55.582312925170065
        }
      ],
      "start": 40.367392290249434,
      "end": 55.582312925170065
    },
    {
      "id": "verify",
      "title": "检查见证，不另造一个世界",
      "tag": "当前实现 · 架构示意",
      "visual": "witness",
      "lines": [
        {
          "text": "T 零检查源码之外的测试路线：希望尝试哪些行动、检查什么目标。它使用同一编译产物，真实运行。",
          "focus": "witness",
          "start": 56.082312925170065,
          "end": 64.7795918367347
        },
        {
          "text": "一条路线失败，不等于所有玩法都不可达。",
          "focus": "limit",
          "start": 65.2795918367347,
          "end": 68.87936507936507
        }
      ],
      "start": 56.082312925170065,
      "end": 68.87936507936507
    },
    {
      "id": "admission",
      "title": "实验一：只改一条限制",
      "tag": "已保存真实报告 · 摘要动画",
      "visual": "admission",
      "lines": [
        {
          "text": "只给女巫规则增加不能自救。开局和请求不变，前九步行动、事件及规则来源相同。",
          "focus": "prefix",
          "start": 69.37936507936507,
          "end": 76.71532879818594
        },
        {
          "text": "第十步从成功变为拒绝，本步无写入。救人候选仍然存在，这不是菜单自动过滤。",
          "focus": "reject",
          "start": 77.21532879818594,
          "end": 84.13904761904762
        }
      ],
      "start": 69.37936507936507,
      "end": 84.13904761904762
    },
    {
      "id": "consequence",
      "title": "实验二：行动都合法，后果不同",
      "tag": "已保存真实报告 · 摘要动画",
      "visual": "vote",
      "lines": [
        {
          "text": "三名狼人分别选择 F、F、E。只把共同袭击规则从全票一致换成多数票。",
          "focus": "votes",
          "start": 84.63904761904762,
          "end": 91.542358276644
        },
        {
          "text": "十次行动全部获准，但全票版无人死亡，多数票版 F 清晨死亡。规则也决定真实后果。",
          "focus": "result",
          "start": 92.042358276644,
          "end": 99.65428571428572
        }
      ],
      "start": 84.63904761904762,
      "end": 99.65428571428572
    },
    {
      "id": "configuration",
      "title": "实验三：换职业，扩人数",
      "tag": "已保存真实报告 · 摘要动画",
      "visual": "seats",
      "lines": [
        {
          "text": "保持规则不变，把女巫从 B 换到 E，通知、选项和行动来源一起转到 E。",
          "focus": "role",
          "start": 100.15428571428572,
          "end": 106.17519274376417
        },
        {
          "text": "增加 G、H 后，有独立视图，G 能真实投票。仍须同步人物声明与开局，不是只改人数开关。",
          "focus": "seats",
          "start": 106.67519274376417,
          "end": 115.05433106575964
        }
      ],
      "start": 100.15428571428572,
      "end": 115.05433106575964
    },
    {
      "id": "adventure",
      "title": "从单条实验，到规则组合",
      "tag": "M1 当前有限改编 · 关系示意，非实玩画面",
      "visual": "adventure",
      "lines": [
        {
          "text": "冰宫冒险 M 一，把充能、寒冷、观察、角色有限选择和营救组合起来。",
          "focus": "flame",
          "start": 115.55433106575964,
          "end": 121.9813605442177
        },
        {
          "text": "世界真相与角色知识分开。解冻不等于营救，邀请不等于接受。样例不代表完整桌游。",
          "focus": "knowledge",
          "start": 122.4813605442177,
          "end": 130.15936507936507
        }
      ],
      "start": 115.55433106575964,
      "end": 130.15936507936507
    },
    {
      "id": "future",
      "title": "让语言模型提议，而非改写真相",
      "tag": "未来愿景 · LLM 主持人管线尚未实现",
      "visual": "future",
      "lines": [
        {
          "text": "未来，语言模型可以草拟内容，读取授权信息，提出行动，讲述已发生的故事。",
          "focus": "model",
          "start": 130.65936507936507,
          "end": 137.40163265306123
        },
        {
          "text": "但不能绕过规则写入结局。想象力与确定性结算，在这里连接。",
          "focus": "boundary",
          "start": 137.90163265306123,
          "end": 143.69573696145125
        }
      ],
      "start": 130.65936507936507,
      "end": 143.69573696145125
    },
    {
      "id": "status",
      "title": "现在做成了什么？",
      "tag": "当前范围与真实归因",
      "visual": "status",
      "lines": [
        {
          "text": "当前已有有限编译链、结算内核、见证检查与真实编辑实验。尚不是通用 TRPG、多人服务或语言模型主持人。",
          "focus": "scope",
          "start": 144.19573696145125,
          "end": 153.77215419501132
        },
        {
          "text": "发起者负责问题、方向、语义决策与验收。后期主要代码由 Codex 和协作者实现或审阅。",
          "focus": "credit",
          "start": 154.27215419501132,
          "end": 161.91079365079366
        }
      ],
      "start": 144.19573696145125,
      "end": 161.91079365079366
    },
    {
      "id": "close",
      "title": "故事，是世界运行的历史",
      "tag": "NomosEngine2",
      "visual": "close",
      "lines": [
        {
          "text": "从中文导览开始，再看真实命令回放，或亲手改一条规则。",
          "focus": "read",
          "start": 162.41079365079366,
          "end": 167.55913832199548
        },
        {
          "text": "作者定义世界允许发生什么，玩家决定故事如何发生。",
          "focus": "world",
          "start": 168.05913832199548,
          "end": 172.46956916099774
        }
      ],
      "start": 162.41079365079366,
      "end": 172.46956916099774
    }
  ],
  "duration": 173.76956916099775
}

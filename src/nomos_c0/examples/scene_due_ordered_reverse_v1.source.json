{
  "schema": "c0.source.scene_due_ordered.v1",
  "lib": {"id": "c0.test.scene_due_ordered", "revision": "v1"},
  "events": [
    {
      "export": "start",
      "lawdef": {"ref": "token_due"},
      "arguments": {
        "carrier_id": "token-A",
        "from_status": "ready",
        "due_field": "start_due",
        "to_status": "moving",
        "receipt_field": "started"
      },
      "when": {"const": true}
    },
    {
      "export": "end",
      "lawdef": {"ref": "token_due"},
      "arguments": {
        "carrier_id": "token-A",
        "from_status": "moving",
        "due_field": "end_due",
        "to_status": "reached",
        "receipt_field": "ended"
      },
      "when": {"const": true}
    }
  ],
  "settlement": {
    "lawdef": {"ref": "ordered_current_recheck.v1"},
    "steps": [
      {"export": "end", "required": false},
      {"export": "start", "required": false}
    ]
  }
}
